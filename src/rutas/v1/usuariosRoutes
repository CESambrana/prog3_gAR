const express = require("express");
const router = express.Router();
const usuariosController = require("../../controladores/usuariosController");
const { validacionDeUsuario, validarCampos, param } = require("../../middlewares/validador");
const { body } = require("express-validator");
const verificarToken = require("../../middlewares/verificarToken");
const verificarRol = require("../../middlewares/verificarRol");
const upload = require("../../middlewares/upload");

/**
 * @swagger
 * tags:
 *   name: Usuarios
 *   description: Gestión de usuarios del sistema
 */

/**
 * @swagger
 * /api/v1/usuarios:
 *   get:
 *     summary: Listar todos los usuarios
 *     tags: [Usuarios]
 *     security:
 *       - bearerAuth: []
 *     responses:
 *       200:
 *         description: Lista de usuarios activos
 *   post:
 *     summary: Crear un usuario
 *     tags: [Usuarios]
 *     security:
 *       - bearerAuth: []
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required: [documento, apellido, nombres, email, contrasenia, rol]
 *             properties:
 *               documento:
 *                 type: string
 *                 example: "12345678"
 *               apellido:
 *                 type: string
 *                 example: García
 *               nombres:
 *                 type: string
 *                 example: Juan
 *               email:
 *                 type: string
 *                 example: juagar@correo.com
 *               contrasenia:
 *                 type: string
 *                 example: juagar
 *               rol:
 *                 type: integer
 *                 description: "1=Médico, 2=Paciente, 3=Admin"
 *                 example: 1
 *     responses:
 *       201:
 *         description: Usuario creado correctamente
 */

/**
 * @swagger
 * /api/v1/usuarios/{id}:
 *   get:
 *     summary: Obtener un usuario por ID
 *     tags: [Usuarios]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: integer
 *     responses:
 *       200:
 *         description: Usuario encontrado
 *       404:
 *         description: No encontrado
 *   put:
 *     summary: Editar un usuario
 *     tags: [Usuarios]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: integer
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             properties:
 *               documento:
 *                 type: string
 *               apellido:
 *                 type: string
 *               nombres:
 *                 type: string
 *               email:
 *                 type: string
 *               rol:
 *                 type: integer
 *     responses:
 *       200:
 *         description: Actualizado correctamente
 *   delete:
 *     summary: Eliminar un usuario - baja lógica
 *     tags: [Usuarios]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: integer
 *     responses:
 *       200:
 *         description: Dado de baja correctamente
 */

/**
 * @swagger
 * /api/v1/usuarios/{id}/foto:
 *   patch:
 *     summary: Subir foto de perfil (admin)
 *     tags: [Usuarios]
 *     security:
 *       - bearerAuth: []
 *     parameters:
 *       - in: path
 *         name: id
 *         required: true
 *         schema:
 *           type: integer
 *     requestBody:
 *       required: true
 *       content:
 *         multipart/form-data:
 *           schema:
 *             type: object
 *             properties:
 *               foto:
 *                 type: string
 *                 format: binary
 *     responses:
 *       200:
 *         description: Foto actualizada correctamente
 */

/* BROWSE - solo admin */
router.get("/", [verificarToken, verificarRol([3])], usuariosController.getUsuarios);

/* READ - solo admin */
router.get("/:id", [verificarToken, verificarRol([3]), param("id", "El ID debe ser un número entero").isInt({ min: 1 }), validarCampos], usuariosController.getUsuarioById);

/* ADD - solo admin */
router.post("/", [verificarToken, verificarRol([3]), ...validacionDeUsuario], usuariosController.crearUsuario);

/* EDIT - solo admin */
router.put(
    "/:id",
    [
        verificarToken,
        verificarRol([3]),
        param("id", "El ID debe ser un número entero").isInt({ min: 1 }),
        body("email", "Ingrese un email válido").optional().isEmail(),
        body("contrasenia", "Mínimo 6 caracteres").optional().isLength({ min: 6 }),
        validarCampos
    ],
    usuariosController.editarUsuario
);

/* DELETE - solo admin */
router.delete("/:id", [verificarToken, verificarRol([3]), param("id", "El ID debe ser un número entero").isInt({ min: 1 }), validarCampos], usuariosController.eliminarUsuario);

/* FOTO - solo admin */
router.patch(
    "/:id/foto",
    [verificarToken, verificarRol([3]), param("id", "El ID debe ser un número entero").isInt({ min: 1 }), validarCampos, upload.single('foto')],
    usuariosController.patchFoto
);

module.exports = router;